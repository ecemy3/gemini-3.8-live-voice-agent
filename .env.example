# --- Vertex AI ---------------------------------------------------------------
# Kimlik doğrulama ADC ile yapılır: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Her model kendi client'ını kendi bölgesiyle oluşturur.
# GOOGLE_CLOUD_LOCATION'ı TANIMLAMAYIN; iki model arasında çakışma yaratır.
LIVE_LOCATION=us-central1      # gemini-3.8-live: us-central1
FLASH_LOCATION=us              # gemini-3.8-flash: us çoklu bölge (ölçümde global 5-99 sn, us 1,8-2,8 sn)
TRANSCRIBE_LOCATION=global     # gemini-3.5-transcribe-live-preview: yalnızca global (Agent Assist)

# Agent Assist duygu analizi. Boş = Flash (metin). Kendi modeliniz için:
# EMOTION_ANALYZER=paketim.modulum:SinifAdi   (bkz. app/emotion.py)
EMOTION_ANALYZER=

# --- Sunucu ------------------------------------------------------------------
# Virgülle ayrılmış izinli origin listesi (HTTP CORS + WebSocket Origin kontrolü)
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO
